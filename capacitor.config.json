{
  "appId": "com.stahapatis.app",
  "appName": "Sthapati",
  "webDir": "www",
  "server": {
    "url": "https://sthapatiapp.com",
    "cleartext": false,
    "errorPath": "index.html",
    "allowNavigation": [
      "sthapatiapp.com",
      "*.sthapatiapp.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 15000,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#ffffff"
    },
    "CapacitorCookies": {
      "enabled": true
    }
  }
}
